--- /dev/null
+++ b/build/config/wasm/BUILD.gn
@@ -0,0 +1,10 @@
+# Project-local Emscripten target configuration.
+
+config("compiler") {
+  defines = [
+    # PDFium's Linux font fallback is also its existing ASM.js/WASM fallback.
+    "OS_ASMJS",
+    # Required by libopenjpeg for fseeko()/ftello().
+    "_POSIX_C_SOURCE=200112",
+  ]
+}
