+
+void CPDF_Form::DetachStreamForEditing() {
+  auto isolated = ToStream(form_stream_->Clone());
+  CHECK(isolated);
+  auto isolated_dict = isolated->GetMutableDict();
+  if (resources_) {
+    auto resources = ToDictionary(resources_->Clone());
+    // Cloning the outer dictionary alone leaves indirect category dictionaries
+    // shared. Keep their resource values shared, but detach the name tables.
+    for (const char* key : {"Font", "XObject", "ExtGState", "Properties",
+                            "ColorSpace", "Pattern", "Shading"}) {
+      auto category = resources_->GetDictFor(key);
+      if (category) {
+        resources->SetFor(key, category->Clone());
+      }
+    }
+    isolated_dict->SetFor("Resources", resources);
+    SetResources(std::move(resources));
+  }
+  GetDocument()->AddIndirectObject(isolated);
+  ReplaceDictionaryForEditing(isolated_dict);
+  form_stream_ = std::move(isolated);
+}
 
