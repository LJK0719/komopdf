+  // A font name is not its identity: equal BaseFont names can carry different
+  // encodings, embedded subsets, CID maps and ToUnicode dictionaries.
+  RetainPtr<const CPDF_Object> font_dict = font->GetFontDict();
+  RetainPtr<const CPDF_Dictionary> fonts;
+  if (obj_holder_->GetResources()) {
+    fonts = obj_holder_->GetResources()->GetDictFor("Font");
+  }
+  const auto is_same_font = [&](const CPDF_Object* candidate) {
+    return candidate &&
+           (candidate == font_dict.Get() ||
+            (font_dict->GetObjNum() != 0 &&
+             candidate->GetObjNum() == font_dict->GetObjNum()));
+  };
+  ByteString dict_name = pTextObj->GetResourceName();
+  if (!fonts || dict_name.IsEmpty() ||
+      !is_same_font(fonts->GetDirectObjectFor(dict_name.AsStringView()).Get())) {
+    dict_name.clear();
+    if (fonts) {
+      CPDF_DictionaryLocker locker(fonts.Get());
+      for (const auto& entry : locker) {
+        if (is_same_font(entry.second->GetDirect().Get())) {
+          dict_name = entry.first;
+          break;
+        }
       }
-      document_->AddIndirectObject(font_dict);
