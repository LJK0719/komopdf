+// Text-page character indices and FPDFText_GetText use UTF-16 code units.
+// Preserve that representation when wchar_t is 32-bit (macOS and WASM).
+WideString TextPageUtf16Units(const WideString& value) {
+  if constexpr (sizeof(wchar_t) == 2) {
+    return value;
+  }
+  WideString result;
+  for (char16_t unit : FX_UTF16Encode(value.AsStringView())) {
+    result += static_cast<wchar_t>(unit);
+  }
+  return result;
+}
 
