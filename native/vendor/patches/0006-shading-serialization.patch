+
+void CPDF_PageContentGenerator::ProcessShading(
+    fxcrt::ostringstream* buf,
+    CPDF_ShadingObject* pShadingObj) {
+  RetainPtr<CPDF_ShadingPattern> pattern = pShadingObj->GetPattern();
+  if (!pattern) {
+    return;
+  }
+  RetainPtr<const CPDF_Object> pShadingObj_raw = pattern->GetShadingObject();
+  if (!pShadingObj_raw) {
+    return;
+  }
+
+  RetainPtr<CPDF_Object> indirect_obj;
+  const CPDF_Object* resource_obj = pShadingObj_raw.Get();
+  if (resource_obj->IsInline()) {
+    indirect_obj = resource_obj->Clone();
+    document_->AddIndirectObject(indirect_obj);
+    resource_obj = indirect_obj.Get();
+  }
+
+  ByteString name;
+  RetainPtr<const CPDF_Dictionary> shading_dict;
+  if (obj_holder_->GetResources()) {
+    shading_dict = obj_holder_->GetMutableResources()->GetDictFor("Shading");
+  }
+  const ByteString& existing_name = pShadingObj->GetResourceName();
+  if (shading_dict && !existing_name.IsEmpty()) {
+    RetainPtr<const CPDF_Object> existing_obj =
+        shading_dict->GetDirectObjectFor(existing_name.AsStringView());
+    if (existing_obj && (existing_obj == resource_obj ||
+                         existing_obj->GetObjNum() == resource_obj->GetObjNum())) {
+      name = existing_name;
+    }
+  }
+  if (name.IsEmpty() && shading_dict) {
+    CPDF_DictionaryLocker locker(shading_dict.Get());
+    for (const auto& it : locker) {
+      RetainPtr<const CPDF_Object> direct = it.second->GetDirect();
+      if (direct && direct->GetObjNum() == resource_obj->GetObjNum()) {
+        name = it.first;
+        pShadingObj->SetResourceName(name);
+        break;
+      }
+    }
+  }
+  if (name.IsEmpty()) {
+    name = RealizeResource(resource_obj, "Shading");
+    pShadingObj->SetResourceName(name);
+  }
+
+  ProcessGraphics(buf, pShadingObj);
+
+  const CFX_Matrix& matrix = pShadingObj->matrix();
+  if (!matrix.IsIdentity()) {
+    WriteMatrix(*buf, matrix) << " cm ";
+  }
+
+  *buf << "/" << PDF_NameEncode(name) << " sh";
   EndProcessGraphics(*buf);
 }
 
