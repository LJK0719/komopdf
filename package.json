{
  "name": "komopdf-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "prepare:web-assets": "node scripts/prepare-web-runtime.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:browser": "node scripts/test-browser.mjs",
    "dev:web": "pnpm --filter @pdf-editor/web dev",
    "dev:gateway": "pnpm --filter @pdf-editor/gateway dev"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "tsx": "4.23.15"
  },
  "license": "Apache-2.0"
}
